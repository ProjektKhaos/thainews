{
  "name": "aberg/thai-news",
  "description": "Server-rendered Thailand news aggregator",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "symfony/mailer": "^7.3",
    "symfony/mime": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.3"
  },
  "autoload": {
    "psr-4": {
      "ThaiNews\\": "app/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
